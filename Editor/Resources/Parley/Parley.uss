.pl-root {
    background-color: var(--pl-bg);
    color: var(--pl-text);
    flex-grow: 1;
}

.pl-root Label {
    color: var(--pl-text);
}

.pl-text {
    white-space: normal;
}

.pl-spacer {
    flex-grow: 1;
}

.pl-ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-muted {
    color: var(--pl-text-muted);
    font-size: 11px;
    white-space: normal;
}

.pl-mono {
    font-size: 11px;
}

/* Buttons */

.pl-button {
    margin: 2px 4px 2px 0;
    padding: 3px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--pl-border);
    background-color: var(--pl-surface-3);
    color: var(--pl-text);
}

.pl-button:hover {
    border-color: var(--pl-accent);
    background-color: var(--pl-surface-2);
}

.pl-button:active {
    background-color: var(--pl-surface);
}

.pl-button:focus {
    border-color: var(--pl-accent);
}

.pl-button:disabled {
    opacity: 0.5;
}

.pl-root .pl-button--primary,
.pl-root .pl-button--primary:hover {
    background-color: var(--pl-accent-fill);
    border-color: var(--pl-accent-fill);
    color: var(--pl-accent-text);
    -unity-font-style: bold;
}

.pl-root .pl-button--primary:hover {
    background-color: var(--pl-accent-fill-hover);
}

.pl-root .pl-button--primary:active {
    background-color: var(--pl-accent-fill);
}

.pl-root .pl-button--danger {
    color: var(--pl-error);
    border-color: var(--pl-error);
}

.pl-root .pl-button--danger:hover {
    background-color: var(--pl-error-bg);
}

.pl-root .pl-button--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.pl-root .pl-button--ghost:hover {
    background-color: var(--pl-surface-3);
}

.pl-root .pl-button--ghost:focus {
    border-color: var(--pl-accent);
}

.pl-root .pl-button--small {
    padding: 1px 6px;
    font-size: 11px;
}

.pl-root .pl-button--chip {
    margin: 0 0 0 4px;
    padding: 0 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 10px;
}

.pl-root .pl-button--chip:hover {
    color: var(--pl-error);
    background-color: rgba(0, 0, 0, 0);
}

/* Toolbar */

.pl-toolbar {
    flex-shrink: 0;
}

.pl-toolbar .unity-toolbar-button {
    -unity-text-align: middle-left;
}

.pl-toolbar .pl-toolbar__shrink {
    flex-shrink: 1;
    min-width: 40px;
    max-width: 220px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-toolbar .pl-preview-button {
    color: var(--pl-plan);
    -unity-font-style: bold;
}

.pl-mode--plan {
    color: var(--pl-plan);
    -unity-font-style: bold;
}

.pl-mode--auto {
    color: var(--pl-success);
}

.pl-mode--danger {
    color: var(--pl-error);
    -unity-font-style: bold;
}

.pl-root .pl-toolbar .pl-update,
.pl-root .pl-toolbar .pl-update:hover {
    background-color: var(--pl-update);
    color: var(--pl-update-text);
    -unity-font-style: bold;
}

.pl-root .pl-toolbar .pl-update:hover {
    background-color: var(--pl-update-hover);
}

/* Auth card */

.pl-auth {
    flex-shrink: 0;
    margin: 6px 8px 0 8px;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--pl-warning);
    background-color: var(--pl-warning-bg);
}

.pl-trust {
    flex-shrink: 0;
    margin: 6px 8px 0 8px;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--pl-accent);
    background-color: var(--pl-request-bg);
}

.pl-root .pl-auth__title {
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.pl-auth__text {
    white-space: normal;
    margin-bottom: 4px;
}

.pl-auth__buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

/* Layout */

.pl-split {
    flex-grow: 1;
}

.pl-transcript {
    flex-grow: 1;
    min-width: 200px;
}

.pl-transcript__scroll {
    flex-grow: 1;
}

.pl-transcript__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 8px 10px 16px 10px;
}

.pl-empty {
    margin-top: 40px;
    align-items: center;
}

.pl-root .pl-empty__title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--pl-text-muted);
}

.pl-root .pl-empty__profile {
    margin-top: 2px;
    font-size: 11px;
    color: var(--pl-text-muted);
}

.pl-root .pl-empty__text {
    max-width: 420px;
    margin-top: 12px;
    -unity-text-align: upper-center;
    color: var(--pl-text-muted);
    white-space: normal;
}

.pl-empty__tips {
    margin-top: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    background-color: var(--pl-surface);
}

.pl-empty__tip {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.pl-root .pl-empty__key {
    min-width: 80px;
    margin-right: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    font-size: 11px;
}

.pl-root .pl-empty__tip-text {
    font-size: 11px;
    color: var(--pl-text-muted);
}

/* Entries */

.pl-entry {
    margin: 0px 8px 8px 8px;
}

.pl-entry--user {
    align-self: flex-end;
    max-width: 88%;
    padding: 6px 10px;
    border-radius: 10px;
    background-color: var(--pl-user-bg);
}

.pl-entry--assistant {
    padding: 0;
}

.pl-entry--notice {
    margin-top: 2px;
}

.pl-block {
    margin: 2px 0;
}

.pl-block--thinking .unity-foldout__text {
    color: var(--pl-text-muted);
    -unity-font-style: italic;
}

.pl-root .pl-thinking__text {
    color: var(--pl-text-muted);
    -unity-font-style: italic;
    white-space: normal;
    padding-left: 4px;
    border-left-width: 2px;
    border-left-color: var(--pl-border);
}

.pl-image {
    max-width: 100%;
    margin: 4px 0;
    border-radius: 4px;
}

.pl-root .pl-image__error {
    margin: 4px 0;
    color: var(--pl-error);
}

.pl-notice {
    padding: 4px 8px;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: var(--pl-border);
    background-color: var(--pl-surface);
}

.pl-notice--info {
    border-left-color: var(--pl-accent);
}

.pl-notice--warning {
    border-left-color: var(--pl-warning);
    background-color: var(--pl-warning-bg);
}

.pl-notice--error {
    border-left-color: var(--pl-error);
    background-color: var(--pl-error-bg);
}

.pl-notice__text {
    white-space: normal;
}

/* Markdown */

.pl-md {
    margin: 0;
}

.pl-md-p {
    white-space: normal;
    margin: 2px 0;
}

.pl-md-h1 {
    font-size: 17px;
    -unity-font-style: bold;
    margin: 8px 0 4px 0;
}

.pl-md-h2 {
    font-size: 14px;
    -unity-font-style: bold;
    margin: 8px 0 3px 0;
}

.pl-md-h3,
.pl-md-h4 {
    font-size: 12px;
    -unity-font-style: bold;
    margin: 6px 0 2px 0;
}

.pl-md-code {
    margin: 4px 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--pl-border);
    background-color: var(--pl-code-bg);
}

.pl-md-code--error {
    border-color: var(--pl-error);
}

.pl-md-code__header {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px 2px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
}

.pl-root .pl-md-code__lang {
    font-size: 10px;
    color: var(--pl-text-muted);
}

.pl-md-code__scroll {
    max-height: 420px;
}

.pl-md-code__text {
    padding: 6px 8px;
    white-space: nowrap;
}

.pl-md-quote {
    margin: 2px 0;
    padding-left: 8px;
    border-left-width: 3px;
    border-left-color: var(--pl-border);
}

.pl-md-list {
    margin: 2px 0;
}

.pl-md-list__item {
    flex-direction: row;
    align-items: flex-start;
}

.pl-root .pl-md-list__bullet {
    min-width: 16px;
    color: var(--pl-text-muted);
}

.pl-md-list__text {
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
}

.pl-md-table {
    margin: 4px 0;
}

.pl-md-table__row {
    flex-direction: row;
}

.pl-md-table__row--header {
    -unity-font-style: bold;
    background-color: var(--pl-surface-3);
}

.pl-md-table__cell {
    min-width: 80px;
    flex-grow: 1;
    flex-basis: 0;
    padding: 2px 6px;
    border-width: 0 1px 1px 0;
    border-color: var(--pl-border);
    white-space: normal;
}

.pl-md-rule {
    height: 1px;
    margin: 6px 0;
    background-color: var(--pl-border);
}

/* Tool cards */

.pl-tool {
    margin: 4px 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--pl-border);
    background-color: var(--pl-surface);
}

.pl-tool__header {
    flex-direction: row;
    align-items: center;
    padding: 3px 8px;
}

.pl-tool__header:hover {
    background-color: var(--pl-surface-2);
}

.pl-tool__header {
    cursor: link;
}

.pl-root .pl-tool__status {
    min-width: 14px;
    color: var(--pl-text-muted);
}

.pl-root .pl-tool__status--running {
    color: var(--pl-accent);
}

.pl-root .pl-tool__status--done {
    color: var(--pl-success);
}

.pl-root .pl-tool__status--error {
    color: var(--pl-error);
}

.pl-root .pl-tool__status--stopped {
    color: var(--pl-warning);
}

.pl-root .pl-tool__title {
    flex-shrink: 0;
    max-width: 60%;
    -unity-font-style: bold;
    margin-right: 6px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-tool__summary {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    color: var(--pl-text-muted);
    text-overflow: ellipsis;
}

.pl-root .pl-tool__chevron {
    color: var(--pl-text-muted);
    margin-left: 4px;
}

.pl-tool__body {
    padding: 0 8px 6px 8px;
}

.pl-tool__children {
    margin: 0 0 4px 12px;
    padding-left: 6px;
    border-left-width: 2px;
    border-left-color: var(--pl-border);
}

.pl-root .pl-tool__error {
    color: var(--pl-error);
    white-space: normal;
}

.pl-tool__result {
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--pl-border);
}

/* Diff */

.pl-diff {
    margin: 4px 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--pl-border);
    background-color: var(--pl-code-bg);
}

.pl-diff__header {
    flex-direction: row;
    padding: 2px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
}

.pl-patch__header {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.pl-patch__header > .pl-diff__title {
    margin-right: 6px;
}

.pl-diff__title {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 11px;
}

.pl-root .pl-diff__added {
    color: var(--pl-success);
    margin-left: 6px;
    font-size: 11px;
}

.pl-root .pl-diff__removed {
    color: var(--pl-error);
    margin-left: 6px;
    font-size: 11px;
}

.pl-diff__scroll {
    max-height: 420px;
}

.pl-diff__row {
    padding: 0 8px;
    white-space: nowrap;
}

.pl-diff__row--add {
    background-color: var(--pl-diff-add);
}

.pl-diff__row--del {
    background-color: var(--pl-diff-del);
}

.pl-root .pl-diff__row--hunk {
    background-color: var(--pl-diff-hunk);
    color: var(--pl-text-muted);
}

/* Todos and tasks */

.pl-todo {
    margin: 1px 0;
    white-space: normal;
}

.pl-root .pl-todo--completed {
    color: var(--pl-text-muted);
}

.pl-root .pl-todo--in-progress {
    color: var(--pl-accent);
    -unity-font-style: bold;
}

.pl-task {
    margin-bottom: 6px;
    padding: 4px 6px;
    border-radius: 4px;
    background-color: var(--pl-surface);
}

.pl-task__header {
    flex-direction: row;
    align-items: flex-start;
}

.pl-root .pl-task__icon {
    min-width: 14px;
    color: var(--pl-text-muted);
}

.pl-root .pl-task__icon--running {
    color: var(--pl-accent);
}

.pl-root .pl-task__icon--done {
    color: var(--pl-success);
}

.pl-root .pl-task__icon--failed {
    color: var(--pl-error);
}

.pl-task__title {
    flex-shrink: 1;
    -unity-font-style: bold;
    white-space: normal;
}

.pl-task__summary {
    white-space: normal;
}

/* Requests */

.pl-request {
    margin: 6px 0;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--pl-accent);
    background-color: var(--pl-request-bg);
}

.pl-request--plan {
    border-color: var(--pl-plan);
    background-color: var(--pl-plan-bg);
}

.pl-request--resolved {
    padding: 3px 10px;
    border-color: var(--pl-border);
    background-color: var(--pl-surface);
}

.pl-request__title {
    -unity-font-style: bold;
    font-size: 12px;
    margin-bottom: 4px;
    white-space: normal;
}

.pl-root .pl-request__resolution {
    color: var(--pl-text-muted);
    white-space: normal;
}

.pl-request__buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.pl-request__feedback {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.pl-request__feedback-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
}

.pl-request__detail {
    margin: 4px 0;
}

.pl-question__item--single .unity-toggle__checkmark {
    border-radius: 7px;
}

.pl-question__content--narrow {
    flex-direction: column;
}

.pl-question__content--narrow > .pl-question__preview {
    margin: 6px 0 0 0;
}

.pl-plan__scroll {
    max-height: 480px;
    margin: 4px 0;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: var(--pl-surface);
}

.pl-question__item {
    flex-shrink: 0;
    margin: 6px 0;
}

.pl-question__title {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.pl-question__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-font-style: bold;
}

.pl-chip {
    flex-shrink: 0;
    margin-right: 6px;
    padding: 1px 6px;
    border-radius: 10px;
    background-color: var(--pl-accent-fill);
    font-size: 10px;
}

.pl-root .pl-chip {
    color: var(--pl-accent-text);
}

.pl-question__content--preview {
    flex-direction: row;
}

.pl-question__content--preview > .pl-question__options,
.pl-question__content--preview > .pl-question__preview {
    flex-grow: 1;
    flex-basis: 0;
}

.pl-question__option {
    flex-shrink: 0;
    margin: 1px 0;
}

.pl-question__option .unity-toggle__input {
    flex-shrink: 1;
}

.pl-question__option .unity-toggle__text {
    flex-shrink: 1;
    white-space: normal;
}

.pl-root .pl-question__description {
    margin-left: 20px;
    color: var(--pl-text-muted);
    font-size: 11px;
    white-space: normal;
}

.pl-question__other {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.pl-question__other-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pl-question__preview {
    margin-left: 8px;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: var(--pl-code-bg);
}

/* Composer */

.pl-composer {
    flex-shrink: 0;
    padding: 6px 8px;
    border-top-width: 1px;
    border-top-color: var(--pl-border);
    background-color: var(--pl-surface);
}

.pl-composer__input {
    margin: 0;
    min-height: 44px;
    max-height: 200px;
}

.pl-composer__input > .unity-text-field__input {
    padding: 4px 6px;
    white-space: normal;
}

.pl-composer__bar {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.pl-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.pl-chip-removable {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 2px 0;
    padding: 1px 6px;
    border-radius: 10px;
    background-color: var(--pl-surface-3);
}

.pl-root .pl-chip-removable__label {
    max-width: 220px;
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-chip-removable__kind {
    margin-right: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--pl-text-muted);
}

.pl-composer--drop {
    border-top-color: var(--pl-accent);
    background-color: var(--pl-selected);
}

.pl-suggestions {
    flex-shrink: 0;
    margin-bottom: 4px;
    max-height: 220px;
    overflow: hidden;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--pl-border);
    background-color: var(--pl-surface-2);
}

.pl-suggestion {
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
}

.pl-root .pl-suggestion__name {
    flex-shrink: 0;
    max-width: 100%;
    margin-right: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-suggestion__detail {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--pl-text-muted);
}

.pl-suggestion:hover,
.pl-suggestion--selected {
    background-color: var(--pl-selected);
}

/* Side panel */

.pl-side {
    min-width: 160px;
    border-left-width: 1px;
    border-left-color: var(--pl-border);
    background-color: var(--pl-surface);
}

.pl-side__tabs {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
}

.pl-root .pl-side__tab {
    flex-grow: 1;
    margin: 0 2px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.pl-root .pl-side__tab:hover {
    background-color: var(--pl-surface-2);
}

.pl-root .pl-side__tab--active {
    background-color: var(--pl-selected);
    -unity-font-style: bold;
}

.pl-side__content {
    flex-grow: 1;
}

.pl-side__action {
    align-self: flex-start;
    margin-top: 6px;
}

.pl-side__content > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 8px 10px;
}

/* MCP */

.pl-mcp__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.pl-mcp__title {
    -unity-font-style: bold;
}

.pl-root .pl-mcp__section {
    margin: 12px 0 4px 0;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--pl-text);
}

.pl-mcp__row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 4px;
    padding: 4px 6px;
    border-radius: 4px;
    background-color: var(--pl-surface-2);
}

.pl-mcp__row:hover {
    background-color: var(--pl-surface-3);
}

.pl-mcp__row > .pl-mcp__actions {
    flex-shrink: 0;
    margin: 0 0 0 4px;
}

.pl-mcp__toggle {
    margin: 1px 6px 0 0;
}

.pl-mcp__all {
    margin: 12px 6px 4px 6px;
}

.pl-mcp__main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pl-mcp__name {
    -unity-font-style: bold;
}

.pl-mcp__name--toggle {
    cursor: link;
}

.pl-root .pl-mcp__source {
    font-size: 10px;
    color: var(--pl-text-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-mcp__field-hint {
    margin: 0 0 4px 0;
    font-size: 11px;
    color: var(--pl-text-muted);
}

.pl-field--invalid > .unity-base-text-field__input {
    border-color: var(--pl-error);
}

.pl-root .pl-mcp__detail {
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-mcp__state {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.pl-mcp__state-text {
    font-size: 11px;
}

.pl-mcp__dot {
    width: 7px;
    height: 7px;
    margin-right: 5px;
    border-radius: 4px;
    background-color: var(--pl-text-muted);
}

.pl-mcp__dot--connected {
    background-color: var(--pl-success);
}

.pl-mcp__dot--pending {
    background-color: var(--pl-warning);
}

.pl-mcp__dot--failed {
    background-color: var(--pl-error);
}

.pl-mcp__dot--off {
    background-color: var(--pl-text-muted);
    opacity: 0.6;
}

.pl-root .pl-mcp__error {
    margin-top: 2px;
    font-size: 11px;
    color: var(--pl-error);
}

.pl-root .pl-mcp__hint {
    margin-top: 8px;
    padding: 4px 6px;
    border-radius: 4px;
    font-size: 11px;
    background-color: var(--pl-warning-bg);
}

.pl-mcp__actions {
    flex-direction: row;
    margin-top: 4px;
}

.pl-mcp__form {
    margin-bottom: 8px;
    padding: 6px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--pl-border);
    background-color: var(--pl-surface-2);
}

.pl-mcp__form .unity-text-field,
.pl-mcp__form .unity-enum-field {
    flex-direction: column;
    margin: 2px 0;
}

.pl-mcp__form .unity-text-field > .unity-base-field__label,
.pl-mcp__form .unity-enum-field > .unity-base-field__label {
    min-width: 0;
    margin-bottom: 2px;
}

.pl-mcp__form .pl-mcp__var-fields .unity-text-field {
    flex-direction: row;
}

.pl-root .pl-mcp__subtitle {
    margin: 4px 0;
    -unity-font-style: bold;
}

.pl-mcp__vars {
    margin: 4px 0;
}

.pl-mcp__vars-header {
    flex-direction: row;
    align-items: center;
}

.pl-root .pl-mcp__vars-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--pl-text-muted);
}

.pl-mcp__var-secret {
    flex-shrink: 0;
    margin: 0 2px 0 4px;
}

.pl-mcp__var {
    margin-bottom: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
}

.pl-mcp__var-fields {
    flex-direction: row;
    align-items: center;
}

.pl-mcp__var-key {
    width: 40%;
    flex-shrink: 0;
}

.pl-mcp__var-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pl-mcp__var-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.pl-mcp__form-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
}

/* Status bar */

.pl-status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 20px;
    padding: 0 8px;
    border-top-width: 1px;
    border-top-color: var(--pl-border);
    background-color: var(--pl-surface-2);
}

.pl-status__dot {
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 4px;
    background-color: var(--pl-success);
}

.pl-status__dot--busy {
    background-color: var(--pl-accent);
}

.pl-status__dot--starting {
    background-color: var(--pl-text-muted);
}

.pl-status__dot--waiting {
    background-color: var(--pl-warning);
}

.pl-status__dot--error {
    background-color: var(--pl-error);
}

.pl-root .pl-status__text {
    flex-shrink: 0;
    font-size: 11px;
    margin-right: 10px;
    white-space: nowrap;
}

.pl-root .pl-status__account,
.pl-root .pl-status__usage {
    flex-shrink: 1;
    font-size: 11px;
    color: var(--pl-text-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-status__usage--warning {
    color: var(--pl-warning);
}

/* Preferences */

.pl-prefs > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 8px 12px 24px 10px;
}

.pl-prefs__title {
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.pl-prefs__section {
    margin-bottom: 16px;
}

.pl-prefs .unity-base-field > .unity-base-field__label {
    min-width: 200px;
    width: 200px;
}

.pl-prefs__children {
    margin-left: 16px;
}

.pl-prefs__children .unity-base-field > .unity-base-field__label {
    min-width: 184px;
    width: 184px;
}

.pl-banner {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
    padding: 6px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--pl-border);
    background-color: var(--pl-surface);
}

.pl-banner--warning {
    border-color: var(--pl-warning);
    background-color: var(--pl-warning-bg);
}

.pl-banner--error {
    border-color: var(--pl-error);
    background-color: var(--pl-error-bg);
}

.pl-banner__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
}

.pl-prefs__section-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin: 4px 0 4px 0;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
}

.pl-prefs__multiline > .unity-text-field__input {
    min-height: 60px;
    white-space: normal;
}

.pl-prefs__profiles {
    flex-direction: row;
    align-items: flex-start;
}

.pl-prefs__profile-list {
    width: 170px;
    flex-shrink: 0;
    margin-right: 10px;
}

.pl-root .pl-prefs__profile-item {
    flex-direction: column;
    align-items: stretch;
    margin: 0 0 4px 0;
    padding: 4px 8px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.pl-prefs__profile-title {
    flex-direction: row;
    align-items: center;
}

.pl-prefs__profile-name {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.pl-prefs__profile-title > .pl-chip {
    margin: 0 0 0 4px;
}

.pl-prefs__profile-item > .pl-muted {
    -unity-text-align: middle-left;
}

.pl-root .pl-prefs__profile-item--selected {
    background-color: var(--pl-selected);
    border-color: var(--pl-accent);
}

.pl-prefs__profile-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.pl-prefs__profile-editor {
    flex-grow: 1;
    flex-shrink: 1;
}

.pl-profile__method {
    margin: 6px 0;
    padding: 6px 8px;
    border-radius: 6px;
    background-color: var(--pl-surface);
}

.pl-profile__method-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.pl-profile__row {
    flex-direction: row;
    align-items: center;
}

.pl-profile__row > .unity-text-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.pl-profile__buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.pl-profile__status {
    margin: 4px 0 0 0;
    white-space: normal;
}

.pl-root .pl-profile__status--success {
    color: var(--pl-success);
}

.pl-root .pl-profile__status--error {
    color: var(--pl-error);
}

.pl-secret__row {
    flex-direction: row;
    align-items: center;
}

.pl-secret__field {
    flex-grow: 1;
}

.pl-root .pl-secret__status {
    margin-left: 4px;
    font-size: 11px;
    color: var(--pl-text-muted);
}

.pl-root .pl-secret__status--pending,
.pl-root .pl-secret__status--missing {
    color: var(--pl-warning);
}

.pl-cli {
    margin: 6px 0;
    padding: 6px 8px;
    border-radius: 6px;
    background-color: var(--pl-code-bg);
}

.pl-cli__scroll {
    max-height: 200px;
}

.pl-cli__log {
    white-space: normal;
}

/* Skills */

.pl-root .pl-skills__description {
    max-height: 28px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pl-skills__pick {
    margin: 0 4px 0 0;
}

.pl-skills__auto-row {
    align-items: center;
}

.pl-skills__auto-name {
    width: 35%;
    flex-shrink: 1;
    margin: 0;
}

.pl-skills__auto-args {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    margin: 0 4px;
}

.pl-skills__body > .unity-base-text-field__input {
    min-height: 120px;
    max-height: 320px;
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Release notes window */

.pl-release {
    padding: 20px;
}

.pl-root .pl-release__brand {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--pl-accent);
}

.pl-release__headline {
    font-size: 17px;
    -unity-text-align: middle-center;
    margin: 20px 0 14px 0;
}

.pl-root .pl-release__version {
    font-size: 12px;
    color: var(--pl-text-muted);
}

.pl-release__section {
    font-size: 14px;
    -unity-font-style: bold;
    margin: 18px 0 6px 0;
}

.pl-release__notes {
    flex-grow: 1;
    min-height: 0;
    border-width: 1px;
    border-color: var(--pl-border);
    border-radius: 4px;
    background-color: var(--pl-surface);
}

.pl-release__title {
    font-size: 14px;
    -unity-font-style: bold;
    margin: 12px 8px 0 8px;
}

.pl-root .pl-release__error {
    color: var(--pl-error);
    margin: 8px;
}

.pl-root .pl-release__info {
    margin: 8px;
    color: var(--pl-text-muted);
}

.pl-release__notes .pl-md {
    margin: 4px 8px 8px 8px;
}

.pl-release__open {
    align-self: flex-start;
    margin: 0 8px 8px 8px;
}

.pl-release__footer {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 14px;
}

.pl-panel {
    flex-grow: 1;
}

.pl-panel__toolbar {
    flex-shrink: 0;
}

.pl-root .pl-panel__toolbar-title {
    align-self: center;
    margin: 0 6px;
    -unity-font-style: bold;
}

.pl-root .pl-panel__saved {
    align-self: center;
    margin: 0 6px;
    font-size: 11px;
    white-space: nowrap;
    color: var(--pl-text-muted);
}

.pl-root .pl-panel__saved--unsaved {
    color: var(--pl-warning);
}

.pl-panel__name {
    flex-shrink: 1;
    width: 140px;
    min-width: 60px;
    margin: 1px 4px 1px 0;
}

.pl-root .pl-panel__summary {
    margin-bottom: 8px;
}

.pl-panel__warnings {
    padding: 8px 8px 0 8px;
}

.pl-panel__banner {
    flex-shrink: 0;
}

.pl-panel__banner-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px 0 6px;
}

.pl-panel__banner-row > HelpBox {
    flex-grow: 1;
}

.pl-panel__scroll {
    flex-grow: 1;
}

.pl-panel__content {
    padding: 8px;
}

.pl-root .pl-panel__header {
    font-size: 14px;
    -unity-font-style: bold;
    margin: 10px 0 4px 0;
}

.pl-panel__label {
    margin: 2px 0;
}

.pl-panel__separator {
    height: 1px;
    margin: 8px 0;
    background-color: var(--pl-border);
}

.pl-panel__group {
    margin: 6px 0;
    padding: 4px 6px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--pl-border);
    background-color: rgba(0, 0, 0, 0);
}

.pl-panel__group--nested {
    margin: 2px 0;
    padding: 0 0 0 4px;
    border-width: 0;
}

.pl-root .pl-panel__group-title {
    -unity-font-style: bold;
    margin: 0 0 4px 0;
}

.pl-panel__row {
    flex-direction: row;
    align-items: center;
}

.pl-panel__row-item {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 4px;
}

.pl-panel__row-item .unity-base-field__label {
    min-width: 60px;
}

.pl-panel__button {
    align-self: flex-start;
    margin: 4px 4px 4px 0;
}

.pl-panel__missing {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.pl-panel__missing > HelpBox {
    flex-grow: 1;
    flex-shrink: 1;
}

.pl-panel__table {
    margin: 4px 0;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--pl-border);
}

.pl-panel__table-row {
    flex-direction: row;
    align-items: center;
    padding: 1px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
}

.pl-panel__table-row--header {
    background-color: var(--pl-surface-3);
    -unity-font-style: bold;
}

.pl-panel__table-name {
    width: 160px;
    flex-shrink: 0;
    margin: 0 2px;
    -unity-text-align: middle-left;
}

.pl-root .pl-panel__table-link {
    color: var(--pl-link);
    cursor: link;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-panel__table > .pl-muted {
    padding: 2px 6px;
}

.pl-panel__table-cell {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 2px;
}

.pl-panel__table-cell > .unity-base-field > .unity-base-field__label {
    display: none;
}

.pl-panel__list-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--pl-border);
}

.pl-panel__list > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 4px 0;
}

.pl-panel__list-row:hover {
    background-color: var(--pl-surface-2);
}

.pl-panel__list-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 8px;
}

.pl-root .pl-panel__list-name {
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pl-root .pl-panel__list-slug {
    font-size: 11px;
    color: var(--pl-text-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
